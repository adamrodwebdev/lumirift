{
  "name": "lumirift",
  "version": "1.19.1",
  "private": true,
  "description": "Jeu de blocs qui tombent réinventé : 13 modes en quatre familles, défi du jour, duel contre l’IA, en français, anglais et indonésien. Vue 3, TypeScript, mobile d’abord.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview --strictPort",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.vitest.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "build:crazygames": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode crazygames",
    "package:crazygames": "node scripts/package-crazygames.mjs",
    "build:demo": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode demo",
    "build:playgama": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode playgama",
    "package:playgama": "node scripts/package-playgama.mjs"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "vue": "3.5.43",
    "vue-i18n": "11.4.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@intlify/unplugin-vue-i18n": "11.2.5",
    "@playwright/test": "1.64.0",
    "@types/node": "24.13.4",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
