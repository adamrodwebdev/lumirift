{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lumirift-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5175", "--strictPort"],
      "port": 5175
    },
    {
      "name": "lumirift-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "4175"],
      "port": 4175
    },
    {
      "name": "lumirift-playgama",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--mode", "playgama", "--port", "5176", "--strictPort"],
      "port": 5176
    },
    {
      "name": "lumirift-crazygames",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--mode", "crazygames", "--port", "4180", "--strictPort"],
      "port": 4180
    }
  ]
}
